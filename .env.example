# Copy this file to .env and fill in the values you need.
# Everything works locally without any of these set.

# --- Edge module ---
# EDGE_HOST=127.0.0.1
# EDGE_PORT=5000

# --- Azure Machine Learning (python azure_ml.py ...) ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=IoTEdgeLabRG
AZURE_ML_WORKSPACE=aml-weather-lab
AZURE_ML_COMPUTE=weather-ml-compute
AZURE_MODEL_NAME=energy-model
# Endpoint name must be unique in the region (default: energy-ep-<first 8 chars of subscription id>)
# AZURE_ENDPOINT_NAME=energy-ep-yourname
# AZURE_ENDPOINT_INSTANCE_TYPE=Standard_DS2_v2

# --- Deployed endpoint (filled in by: python azure_ml.py endpoint-info --save) ---
AZURE_ENDPOINT_URL=
AZURE_ENDPOINT_KEY=

# --- Azure IoT Hub (optional) ---
# Device connection string: IoT Hub > Devices > <device> > Primary connection string
IOTHUB_DEVICE_CONNECTION_STRING=
# Event Hub-compatible endpoint: IoT Hub > Hub settings > Built-in endpoints
IOTHUB_EVENTHUB_CONNECTION_STRING=
IOTHUB_CONSUMER_GROUP=$Default
